# ========================================================
# Shopify Storefront API Configuration
# ========================================================
# Якщо ці змінні не задані, магазин автоматично працює в Demo Mode
# з 20 автентичними бордспорт-товарами (Capita, Burton, Lib Tech тощо)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=""
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
NEXT_PUBLIC_SHOPIFY_API_VERSION="2026-10"

# ========================================================
# Security & Admin Access (Server-side ONLY, never expose with NEXT_PUBLIC_)
# ========================================================
# Секретний ключ для захисту GET/PATCH запитів до /api/orders та входу в /admin
ADMIN_API_KEY="your-secure-random-admin-api-key-min-32-chars"

# ========================================================
# Telegram Bot Notifications (Optional)
# ========================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
