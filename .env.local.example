# Shopify Storefront API Configuration
# By default, the application connects to Shopify's public mock API (https://mock.shop/api)
# To connect to your real Shopify store:
# 1. In Shopify Admin, create a Custom App with Storefront API permissions
# 2. Add your domain and Storefront Access Token below:

NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=""
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
NEXT_PUBLIC_SHOPIFY_API_VERSION="2024-01"
